# AWS Bedrock & Bedrock Mantle Dual-Provider Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
# Optional: AWS_SESSION_TOKEN=

# Provider Selection: bedrock | mantle
# You can independently configure the provider for fast screening vs deep reasoning:
GATEKEEPER_PROVIDER=bedrock
REASONER_PROVIDER=bedrock

# Model IDs
# Bedrock native examples: amazon.nova-micro-v1:0, anthropic.claude-3-5-sonnet-20241022-v2:0
# Mantle examples: model identifiers deployed or routed through Bedrock Mantle
BEDROCK_GATEKEEPER_MODEL=amazon.nova-micro-v1:0
BEDROCK_REASONER_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0

# Bedrock Mantle Endpoint & Authentication (Used when provider is 'mantle')
# Default endpoint: https://bedrock-mantle.{AWS_REGION}.api.aws/openai/v1
BEDROCK_MANTLE_ENDPOINT=https://bedrock-mantle.us-east-1.api.aws/openai/v1
# Optional: Bedrock API Key (starts with bedrock-api-key-...)
# If left empty when using mantle, EXAMEN automatically mints a short-term token from IAM credentials.
BEDROCK_MANTLE_API_KEY=

# Storage Backend: sqlite | dynamo | agentcore_memory
STORAGE_BACKEND=sqlite
SQLITE_DB_PATH=examen.db

# Multi-user (docs/next_steps/multi_user/): every user has their own data and Bee account
# Data dir: system.db + users/<user_id>/{examen.db, bee/} (homelab: /var/lib/examen/data, set by examen.service)
EXAMEN_DATA_DIR=data
AUTH_PROVIDER=local
AUTH_SESSION_DAYS=14
AUTH_ALLOW_SIGNUP=false
# Set to true when the dashboard is served over HTTPS (Secure cookie flag)
AUTH_COOKIE_SECURE=false
# First start with no users: creates this admin. Without a password, a one-time one is printed in the log
EXAMEN_BOOTSTRAP_ADMIN=admin
# EXAMEN_BOOTSTRAP_ADMIN_PASSWORD=
MAX_ACTIVE_USERS=5
MAX_CONCURRENT_LLM_CALLS=8

# Bee CLI integration (docs/10_bee_cli_reference.md, docs/next_steps/07_bee_data_alignment.md)
# proxy = raw SSE through a private `bee proxy` (30 s pings give real liveness); cli = `bee stream --json`
BEE_STREAM_TRANSPORT=proxy
# Port of the private proxy on 127.0.0.1 (0 = first free port from 8787)
BEE_PROXY_PORT=0
BEE_STREAM_PING_TIMEOUT_SECONDS=90
# Max wait for a `tagged-utterance` (speaker identity) before dispatching an utterance
BEE_SPEAKER_TAG_WAIT_SECONDS=1.5
# Wearer first name (default: read from `bee me`)
# BEE_WEARER_NAME=
# `bee locations current` polling period (0 disables)
BEE_LOCATION_POLL_SECONDS=120

# Serving / MCP Server
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_STREAMABLE_HTTP=true

# Deep Topic Event Engine (docs/next_steps/deep_topic_event_engine/)
# Groups deep_topic speech into events (lectures/meetings) with segment + final syntheses.
EVENT_ENGINE_ENABLED=true
# default | demo (demo compresses all timers: T_soft=20s, T_hard=90s, ...)
EVENT_PROFILE=default
EVENT_T_SOFT_SECONDS=300
EVENT_T_HARD_SECONDS=1800
EVENT_T_HARD_AFTER_CLOSE_CUE_SECONDS=300
EVENT_T_HARD_TRANSIT_SECONDS=120
EVENT_T_CHECKPOINT_SECONDS=1200
EVENT_MIN_SEGMENT_WORDS=300
EVENT_LOCATION_SHIFT_METERS=400
EVENT_TICK_SECONDS=15
EVENT_SYNTHESIS_MAX_WORDS=6000

# Historical Transcript Backfill (docs/next_steps/historical_backfill/)
# Recovers Bee conversations spoken while EXAMEN was offline (gaps in live coverage).
BACKFILL_ENABLED=true
BACKFILL_AUTO_ON_STARTUP=true
BACKFILL_AUTO_ON_RECONNECT=true
BACKFILL_LOOKBACK_DAYS=2
# Catch-up when no coverage exists yet (0 = never analyse the whole account history by surprise)
BACKFILL_FIRST_RUN_DAYS=0
BACKFILL_MAX_WINDOW_DAYS=14
BACKFILL_MAX_ESTIMATED_COST_USD=1.0
BACKFILL_SCREEN_CONCURRENCY=4
BACKFILL_LEDGER_RETENTION_DAYS=14
# Final utterances already spoken live for at least this share of their span are live duplicates
BACKFILL_LIVE_COVERAGE_FRACTION=0.5
# Web search result cache used by event syntheses (0 disables)
WEB_SEARCH_CACHE_TTL_SECONDS=86400

# Topic continuity (Phase C): embedding | heuristic | none (none = resume on first on-topic chunk)
TOPIC_SIMILARITY_BACKEND=embedding
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIMENSIONS=512
# Calibrated on resources/event_scenarios.json (python scripts/replay_event_scenarios.py --calibrate)
TOPIC_SIM_SAME=0.42
TOPIC_SIM_DIFFERENT=0.37
TOPIC_SIM_SAME_HEURISTIC=0.20
TOPIC_SIM_DIFFERENT_HEURISTIC=0.10
TOPIC_WINDOW_MIN_CHUNKS=3
TOPIC_WINDOW_MIN_WORDS=120
TOPIC_PENDING_MAX_AGE_SECONDS=90
TOPIC_DRIFT_WINDOWS=3
TOPIC_DRIFT_MIN_SECONDS=120
TOPIC_LLM_JUDGE=true
