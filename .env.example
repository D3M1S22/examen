# AWS Bedrock & Bedrock Mantle Dual-Provider Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
# Optional: AWS_SESSION_TOKEN=

# Provider Selection: bedrock | mantle
# You can independently configure the provider for fast screening vs deep reasoning:
GATEKEEPER_PROVIDER=bedrock
REASONER_PROVIDER=bedrock

# Model IDs
# Bedrock native examples: amazon.nova-micro-v1:0, anthropic.claude-3-5-sonnet-20241022-v2:0
# Mantle examples: model identifiers deployed or routed through Bedrock Mantle
BEDROCK_GATEKEEPER_MODEL=amazon.nova-micro-v1:0
BEDROCK_REASONER_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0

# Bedrock Mantle Endpoint & Authentication (Used when provider is 'mantle')
# Default endpoint: https://bedrock-mantle.{AWS_REGION}.api.aws/openai/v1
BEDROCK_MANTLE_ENDPOINT=https://bedrock-mantle.us-east-1.api.aws/openai/v1
# Optional: Bedrock API Key (starts with bedrock-api-key-...)
# If left empty when using mantle, EXAMEN automatically mints a short-term token from IAM credentials.
BEDROCK_MANTLE_API_KEY=

# Storage Backend: sqlite | dynamo | agentcore_memory
STORAGE_BACKEND=sqlite
SQLITE_DB_PATH=examen.db

# Serving / MCP Server
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_STREAMABLE_HTTP=true

# Deep Topic Event Engine (docs/next_steps/deep_topic_event_engine/)
# Groups deep_topic speech into events (lectures/meetings) with segment + final syntheses.
EVENT_ENGINE_ENABLED=true
# default | demo (demo compresses all timers: T_soft=20s, T_hard=90s, ...)
EVENT_PROFILE=default
EVENT_T_SOFT_SECONDS=300
EVENT_T_HARD_SECONDS=1800
EVENT_T_HARD_AFTER_CLOSE_CUE_SECONDS=300
EVENT_T_HARD_TRANSIT_SECONDS=120
EVENT_T_CHECKPOINT_SECONDS=1200
EVENT_MIN_SEGMENT_WORDS=300
EVENT_LOCATION_SHIFT_METERS=400
EVENT_TICK_SECONDS=15
EVENT_SYNTHESIS_MAX_WORDS=6000
