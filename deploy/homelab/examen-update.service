# Pulls origin/main and redeploys EXAMEN if it moved (triggered by examen-update.timer).
[Unit]
Description=EXAMEN: pull and apply the deployed branch
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/examen/deploy/homelab/update.sh
